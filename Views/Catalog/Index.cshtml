@using System.Globalization
@model IReadOnlyList<KodaStore.Api.DTOs.ProductResponse>

@{
    Layout = null;
    ViewData["Title"] = "Catalog Page";
    var rupiah = CultureInfo.GetCultureInfo("id-ID");
}
<button><a asp-action="Create">Add Product</a></button>
<table border="1">
    <tr>
        <th>Product Code</th>
        <th>Product</th>
        <th>Category</th>
        <th>Price</th>
        <th>Stock</th>
    </tr>
    <tbody>
        @if (Model.Count == 0)
        {
            <tr>
                <td>Belum ada Product</td>
            </tr>
        }
        else
        {
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductCode</td>
                    <td>@product.Name</td>
                    <td>@product.Category</td>
                    <td>@product.Price.ToString("C0", rupiah)</td>
                    <td>@product.Stock</td>
                    <td>
                        <a asp-action="Details" asp-route-productCode="@product.ProductCode">Details</a>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-productCode="@product.ProductCode">Edit</a>
                    </td>
                    <td>
                        <a asp-action="Delete" asp-route-productCode="@product.ProductCode">Delete</a>
                    </td>
                </tr>
            }
        }
    </tbody>
</table>